<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#161512">
    <meta name="description" content="Apps and browser tools by Roberto Selbach.">
    <meta property="og:title" content="Tools · Roberto Selbach">
    <meta property="og:description" content="Apps and browser tools by Roberto Selbach.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://tools.rselbach.com/">
    <meta name="twitter:card" content="summary">
    <title>Tools · Roberto Selbach</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <div class="wrap">
        <header class="top">
            <a class="brand" href="https://rselbach.com/">Roberto Selbach</a>
            <nav>
                <a href="https://rselbach.com/blog/">Blog</a>
                <a href="https://github.com/rselbach">GitHub</a>
                <a href="https://rselbach.com/index.xml">RSS</a>
            </nav>
        </header>

        <main>
            <p class="intro">These are some of the tools I've been working on.</p>

            {{if .Apps}}
            <section>
                <div class="section-head"><h2>Apps</h2><span>{{len .Apps}} projects</span></div>
                {{range .Apps}}
                <a class="app" href="{{.URL}}">
                    <img src="{{.Icon}}" alt="" width="52" height="52" loading="lazy">
                    <div>
                        <h3>{{.Name}}</h3>
                        <p>{{.Description}}</p>
                    </div>
                    <div class="meta">
                        {{if .Platforms}}<span>{{join .Platforms " · "}}</span>{{end}}
                        {{if .Feed}}<span data-feed="{{.Feed}}"></span>{{end}}
                        <span class="go">{{displayURL .URL}} →</span>
                    </div>
                </a>
                {{end}}
            </section>
            {{end}}

            {{if .Tools}}
            <section>
                <div class="section-head"><h2>Browser tools</h2><span>{{len .Tools}} tools</span></div>
                <ol class="tools">
                    {{range .Tools}}
                    <li><a href="/{{.Path}}/"><b>{{.Name}}</b><span>{{.Description}}</span></a></li>
                    {{end}}
                </ol>
            </section>
            {{end}}
        </main>

        <footer>
            <span>&copy; {{.Year}} Roberto Selbach</span>
            <span>Québec, Canada</span>
        </footer>
    </div>

    <script>
        // each feed is an envelope whose base64 payload names the latest release
        document.querySelectorAll('[data-feed]').forEach(async (el) => {
            try {
                const res = await fetch(el.dataset.feed);
                if (!res.ok) return;
                const { payload } = await res.json();
                const { version } = JSON.parse(atob(payload));
                if (version) el.textContent = 'v' + version;
            } catch {}
        });
    </script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
</body>
</html>
